# Copy to backend/.env and fill in. Never commit .env.
# On Vercel, set the same names in Project Settings > Environment Variables instead.
# A value still starting with "your-" counts as not set.

# AWS Bedrock via the Mantle endpoint
# BEDROCK_REGION is preferred; AWS_REGION also works locally but is reserved on Vercel
BEDROCK_REGION=your-region-where-mantle-works
BEDROCK_API_KEY=your-bedrock-mantle-api-key
# Exact provider-prefixed ID from your Mantle console, e.g. qwen.<model> or anthropic.<model>
BEDROCK_MODEL_ID=your-model-id
# Optional: tried once if the first model answers 403 or 404
BEDROCK_FALLBACK_MODEL_ID=

# ElevenLabs (needs Agents access)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Filled in automatically by: python setup_agents.py
ELEVENLABS_ONBOARDING_AGENT_ID=
ELEVENLABS_INTERVIEWER_AGENT_ID=

# Supabase (Project Settings > API Keys, and the Connect dialog)
# https://<project-ref>.supabase.co
SUPABASE_URL=your-supabase-project-url
# sb_publishable_... Safe to expose; the browser receives it from /api/config
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# sb_secret_... Server only. Used for one thing: deleting a login
SUPABASE_SECRET_KEY=your-supabase-secret-key
# The "Transaction pooler" connection string (port 6543) with the database password filled in
DATABASE_URL=your-transaction-pooler-connection-string

# Per-user daily limits. A day runs midnight to midnight, Europe/London
DAILY_AI_LIMIT=40
DAILY_VOICE_LIMIT=3

# Optional: shown as the contact on the privacy notice page
CONTACT_EMAIL=
