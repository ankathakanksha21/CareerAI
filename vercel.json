{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,backend/.venv/**,backend/tests/**,backend/scripts/**,**/__pycache__/**,docs/**,.claude/**,.superpowers/**}"
    }
  },
  "regions": [
    "lhr1"
  ],
  "crons": [
    {
      "path": "/api/internal/refresh-sponsors",
      "schedule": "0 5 * * 1"
    }
  ]
}
